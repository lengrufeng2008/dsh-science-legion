{
  "name": "dsh-science-legion",
  "version": "0.2.0",
  "description": "Tiered multi-agent science campaigns for DeepSeek Harness: math, physics, astronomy, engineering, and biomedical evidence with independent verification, a shared blackboard, and budget gates. No claim of solving open problems.",
  "type": "module",
  "exports": {
    ".": "./plugin/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "plugin",
    "skills",
    "manifest.json",
    "scripts",
    "evals",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "assets/*.png",
    "REVIEW.md",
    "showcase.html",
    "index.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "science",
    "math",
    "physics",
    "astronomy",
    "multi-agent",
    "swarm",
    "engineering",
    "biomedical",
    "verification",
    "research"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preflight": "node scripts/preflight-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lengrufeng2008/dsh-science-legion.git"
  },
  "homepage": "https://github.com/lengrufeng2008/dsh-science-legion#readme",
  "bugs": {
    "url": "https://github.com/lengrufeng2008/dsh-science-legion/issues"
  },
  "author": "lengrufeng2008"
}
